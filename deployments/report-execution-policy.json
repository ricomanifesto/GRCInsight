{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeReportService",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:076542168556:function:grcinsight-go-function"
      ]
    },
    {
      "Sid": "ReadFunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:076542168556:log-group:/aws/lambda/grcinsight-go-function:*",
        "arn:aws:logs:us-east-1:076542168556:log-group:/aws/lambda/grcinsight-python-function:*"
      ]
    },
    {
      "Sid": "FindFunctionLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    }
  ]
}
