# Go Service Configuration
GO_ENV=development
SERVER_PORT=8080
SERVER_MODE=debug

# Database Configuration
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/grcinsight.db

# Python Service Configuration
PYTHON_SERVICE_URL=http://localhost:8081
PYTHON_SERVICE_TIMEOUT=300s

# Authentication
JWT_SECRET=your-jwt-secret-here
API_KEY=your-api-key-here

# Python Agent Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
LOG_LEVEL=INFO

# Optional: External Services
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://user:pass@localhost/grcinsight
