# Go Service Configuration
GO_ENV=development
SERVER_PORT=8080
SERVER_MODE=debug

# Database Configuration
DATABASE_DRIVER=sqlite
DATABASE_DSN=./data/grcinsight.db

# Python Service Configuration
PYTHON_SERVICE_URL=http://localhost:8081
PYTHON_SERVICE_TIMEOUT=300s

# Shared HTTP authentication for both Go and Python servers.
# Set the same random secret in both environments. Sensitive HTTP routes remain
# unavailable while empty; clients send this value in X-API-Key. Shallow health and the
# static public site stay public. Direct IAM Lambda jobs and CLI runs are separate.
API_KEY=

# Python Agent Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Shared server-owned model identity for Go admission and Python execution.
LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# Optional paid article-relevance pilot: off, shadow, enabled.
GRC_RELEVANCE_MODE=off
GRC_RELEVANCE_MIN_PROBABILITY=0.95
GRC_RELEVANCE_TIMEOUT_SECONDS=4
# Shared secret the Go service sends to the Python report route; set the same
# random value for both services to enable synchronous report runs.
GRC_INTERNAL_TOKEN=
LOG_LEVEL=INFO

# Optional: External Services
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgres://user:pass@localhost/grcinsight
