{
  "title": "Claude Code Usage",
  "uid": "claude-code-usage",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Sessions Started",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(claude_code_session_count_total[$__range]))",
          "legendFormat": "sessions"
        }
      ]
    },
    {
      "id": 2,
      "title": "Lines of Code Modified",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(claude_code_lines_of_code_count_total[$__range]))",
          "legendFormat": "lines"
        }
      ]
    },
    {
      "id": 3,
      "title": "Estimated Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(claude_code_cost_usage_total[$__range]))",
          "legendFormat": "cost"
        }
      ]
    },
    {
      "id": 4,
      "title": "Commits Created",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(increase(claude_code_commit_count_total[$__range]))",
          "legendFormat": "commits"
        }
      ]
    },
    {
      "id": 5,
      "title": "Token Usage Over Time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (type) (rate(claude_code_token_usage_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Tool Decisions",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (decision) (rate(claude_code_tool_decision_total[5m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Recent Claude Code Events",
      "type": "logs",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{exporter=\"OTLP\"}"
        }
      ]
    }
  ]
}
